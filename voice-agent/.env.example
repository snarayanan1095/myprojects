# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Port to listen on (default 3000)
PORT=3000

# Optional: Project context injected into every system prompt
PROJECT_CONTEXT=You are a voice coding assistant. The user is directing you via voice from their phone. Keep responses concise and actionable. When asked to make code changes, explain what you would do clearly.
